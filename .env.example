# Kopyalayıp .env olarak kaydedin. Gerçek şifre/anahtar yazmayın.

DATABASE_URL=mysql+pymysql://root:@localhost:3306/staj?charset=utf8mb4

GOOGLE_API_KEY=
# GEMINI_API_KEY=

# Görev atama e-postası. Değerleri boş bırakın; çalıştıran kişi doldurur.
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=CRM Analiz Portalı
SMTP_USE_TLS=true
SMTP_TIMEOUT=20

# Üretimde mutlaka rastgele uzun bir değer verin.
JWT_SECRET_KEY=

# Firebase Cloud Messaging (uygulama kapalıyken push).
# Konsoldan indirdiğiniz servis hesabı JSON yolunu yazın.
# Dosyayı git'e eklemeyin.
FCM_ENABLED=true
FIREBASE_CREDENTIALS=firebase-service-account.json

# Aynı Firebase projesine Web uygulaması ekleyip yapıştırın.
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_VAPID_KEY=
